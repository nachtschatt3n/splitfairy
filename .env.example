# Required for local use
ADMIN_EMAIL=you@example.com
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters-long
SMTP_HOST=mail.example.com
SMTP_PORT=587
# false = STARTTLS on 587, true = TLS on 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Splitfairy <noreply@example.com>
# Existing private Ollama
OLLAMA_URL=http://192.168.30.111:11434
OLLAMA_MODEL=gemma4:26b-mlx
DATA_DIR=./data
LOG_LEVEL=info
# Local development without SMTP: write sign-in and invitation emails as JSON files here
# MAIL_CAPTURE_DIR=./data/mail
